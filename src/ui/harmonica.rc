// harmonica.rc —— 资源脚本（纯 ASCII：rc.exe 按当前代码页读脚本，中文注释会乱）
#include <windows.h>

// 程序图标（101 与 Windows 里的 IDI_APPLICATION 位置无关，是我们自己的编号）
101 ICON "harmonica.ico"

// 清单：公共控件 v6 + PerMonitorV2 DPI + asInvoker
1 RT_MANIFEST "harmonica.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,7,0,0
 PRODUCTVERSION 0,7,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Harmonica Player Project"
            VALUE "FileDescription", "Harmonica Player - Phase 7 GUI"
            VALUE "FileVersion", "0.7.0.0"
            VALUE "InternalName", "HarmonicaPlayer"
            VALUE "LegalCopyright", "See NOTICE in the project"
            VALUE "OriginalFilename", "HarmonicaPlayer.exe"
            VALUE "ProductName", "Harmonica Player"
            VALUE "ProductVersion", "0.7.0.0"
            VALUE "Comments", "In-game harmonica auto player (Chinese UI, no emoji)"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
